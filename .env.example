# Exemplo de configuração local
# Copie para .env e preencha as chaves dos providers reais antes de iniciar a API.

GEMINI_API_KEY=
GROQ_API_KEY=
TYPESAFE_API_KEY=

# PostgreSQL local
POSTGRES_DB=assessor
POSTGRES_USER=assessor
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://assessor:change-me-local@localhost:5432/assessor

# MongoDB local: o Compose publica a porta 27018 no host.
MONGO_PORT=27018
MONGODB_URI=mongodb://localhost:27018

# Qdrant local. A chave é usada pela API e pelo serviço local Qdrant.
QDRANT_API_KEY=local-qdrant-dev-key
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# OAuth Desktop para o servidor MCP oficial do Google Calendar.
# Coloque o arquivo de credenciais fornecido pelo Google na raiz do projeto.
GOOGLE_OAUTH_CREDENTIALS=gcp-oauth.keys.json
GOOGLE_CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1
